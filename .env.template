# Server configuration
NODE_ENV=development
LOG_LEVEL=info
AUTH_SESSION_DURATION_SECONDS=2592000

# Browser-safe configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database connection for the active process user
# Set DATABASE_USER to turing_migrate when running migrations.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=turing_tank
DATABASE_USER=turing_app
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Local PostgreSQL owner bootstrap password
POSTGRES_PASSWORD=change-me-owner
